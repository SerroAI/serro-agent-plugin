{
  "hooks": {
    "PostToolUse": [
      { "type": "command", "command": "sh \"${PLUGIN_ROOT}/scripts/serro-hook\" joined copilot", "windows": "exit 0", "powershell": "exit 0", "timeout": 10 }
    ],
    "UserPromptSubmit": [
      { "type": "command", "command": "sh \"${PLUGIN_ROOT}/scripts/serro-hook\" prompt copilot", "windows": "exit 0", "powershell": "exit 0", "timeout": 10 }
    ],
    "Stop": [
      { "type": "command", "command": "sh \"${PLUGIN_ROOT}/scripts/serro-hook\" stop copilot", "windows": "exit 0", "powershell": "exit 0", "timeout": 10 }
    ]
  }
}
